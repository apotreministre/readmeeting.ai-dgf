# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# MICROSOFT ENTRA ID (AZURE AD) - DGF TENANT
# ==========================================
# ID d'application (client) généré lors de l'enregistrement de l'App dans Entra ID
VITE_AZURE_CLIENT_ID=""

# ID de l'annuaire (tenant) du locataire DGF (ex: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
VITE_AZURE_TENANT_ID=""

# URI de redirection configurée dans la section Authentification SPA de l'App Registration
VITE_AZURE_REDIRECT_URI=""

# Scopes Microsoft Graph requis pour les réunions et transcriptions
VITE_GRAPH_SCOPES="User.Read Calendars.Read OnlineMeetings.Read"
